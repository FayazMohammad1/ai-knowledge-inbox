# Copy to .env. Everything is optional: with no GEMINI_API_KEY the app runs fully offline
# using local hash embeddings and returns the best passages instead of an LLM answer.

PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
# DB_PATH=./data/inbox.db

# --- Google Gemini ---
GEMINI_API_KEY=
# EMBEDDING_MODEL=gemini-embedding-001
# CHAT_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT_MS=30000

# Force a provider (defaults: "gemini" when a key is set, else "local"/"extractive")
# EMBEDDING_PROVIDER=local        # local | gemini
# LLM_PROVIDER=extractive         # extractive | gemini

# --- Pipeline tuning ---
# CHUNK_MAX_CHARS=800
# CHUNK_OVERLAP_CHARS=100
# RETRIEVAL_TOP_K=4
# RETRIEVAL_MIN_SCORE=0.15        # cosine floor; unset = the embedder's default (local 0.03, gemini 0.15)
# INGEST_CONCURRENCY=2
# INGEST_MAX_ATTEMPTS=3

# --- Safety ---
# URL_FETCH_TIMEOUT_MS=10000
# URL_FETCH_MAX_BYTES=2097152
# ALLOW_PRIVATE_URLS=false        # true disables the SSRF guard. Local debugging only.
# RATE_LIMIT_INGEST_PER_MIN=30
# RATE_LIMIT_QUERY_PER_MIN=30
